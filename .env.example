# --- Web ---
HOST=0.0.0.0
PORT=8765
BASE_URL=https://tu-dominio.com
SESSION_SECURE=1
TRUST_PROXY=1

# --- Base de datos ---
# Para PostgreSQL / Supabase pega la cadena completa de conexión.
# Ejemplo genérico: postgresql://usuario:clave@host:5432/postgres?sslmode=require
DATABASE_URL=

# --- Sincronización en servidor ---
BACKGROUND_SYNC_ENABLED=1
BACKGROUND_SYNC_INTERVAL=900
BACKGROUND_INITIAL_DELAY=15
CACHE_TTL_SECONDS=900

# --- Correo de alertas (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
SMTP_SSL=0
